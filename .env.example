# API Base URL
# - In production behind an Nginx reverse proxy (recommended), leave as /api
# - If backend is hosted on a separate domain or port, set full URL:
#   VITE_API_URL=https://api.yourdomain.com/api
#   or VITE_API_URL=http://your-server-ip:3001/api
VITE_API_URL=/api
